{% extends 'base.html.twig' %}

{% block title %}Admin — Create User{% endblock %}

{% block body %}
<style>
/* ... your existing styles ... */

/* Add error message styles */
.error-message {
    color: #ff5555;
    font-size: 0.9rem;
    margin-top: 5px;
    padding: 5px 10px;
    background: rgba(255, 85, 85, 0.1);
    border-radius: 5px;
    border-left: 3px solid #ff5555;
}

.form-group.has-error .form-control {
    border-color: #ff5555 !important;
    background: rgba(255, 85, 85, 0.05);
}

.flash-messages {
    width: 100%;
    margin-bottom: 20px;
}

.alert {
    padding: 12px 20px;
    border-radius: 8px;
    margin-bottom: 10px;
    font-weight: 600;
}

.alert-success {
    background: rgba(0, 255, 170, 0.15);
    border: 1px solid #00ffaa;
    color: #00ffaa;
}

.alert-error {
    background: rgba(255, 85, 85, 0.15);
    border: 1px solid #ff5555;
    color: #ff5555;
}
</style>

<!-- ... your existing background script ... -->

<div class="admin-wrapper">
    <div class="glass-panel">
        <h1>Create Admin User</h1>
        <p>Restricted access — administrators only</p>
        
        <!-- Flash Messages -->
        <div class="flash-messages">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    ✅ {{ message }}
                </div>
            {% endfor %}
            
            {% for message in app.flashes('error') %}
                <div class="alert alert-error">
                    ❌ {{ message }}
                </div>
            {% endfor %}
        </div>

        {{ form_start(form) }}
            
            <!-- Email field -->
            <div class="form-group {% if form.email.vars.errors|length %}has-error{% endif %}">
                {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder':'Enter email'}}) }}
                {% if form.email.vars.errors|length %}
                    {% for error in form.email.vars.errors %}
                        <div class="error-message">{{ error.message }}</div>
                    {% endfor %}
                {% endif %}
            </div>
            
            <!-- Password fields -->
            <div class="form-group {% if form.plainPassword.first.vars.errors|length %}has-error{% endif %}">
                {{ form_label(form.plainPassword.first, 'Password', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder':'Enter password'}}) }}
                {% if form.plainPassword.first.vars.errors|length %}
                    {% for error in form.plainPassword.first.vars.errors %}
                        <div class="error-message">{{ error.message }}</div>
                    {% endfor %}
                {% endif %}
            </div>
            
            <div class="form-group {% if form.plainPassword.second.vars.errors|length %}has-error{% endif %}">
                {{ form_label(form.plainPassword.second, 'Repeat Password', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder':'Repeat password'}}) }}
                {% if form.plainPassword.second.vars.errors|length %}
                    {% for error in form.plainPassword.second.vars.errors %}
                        <div class="error-message">{{ error.message }}</div>
                    {% endfor %}
                {% endif %}
            </div>
            
            <!-- Check if passwords match -->
            {% if form.plainPassword.vars.errors|length %}
                {% for error in form.plainPassword.vars.errors %}
                    <div class="error-message">{{ error.message }}</div>
                {% endfor %}
            {% endif %}
            
            <!-- Checkbox -->
            <div class="form-check">
                {{ form_widget(form.isAdmin, {'attr': {'class': 'form-check-input'}}) }}
                {{ form_label(form.isAdmin, null, {'label_attr': {'class': 'form-label'}}) }}
            </div>
            
            <button type="submit" class="btn-neon">Create User</button>
            
        {{ form_end(form) }}
    </div>
</div>

{% endblock %}