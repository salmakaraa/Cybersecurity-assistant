{% extends 'base.html.twig' %}

{% block title %}Cybersecurity Assistant — Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/code_scan.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
{% endblock %}

{% block body %}
<style>
    body {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        background: #0a0f1f;
        font-family: 'Segoe UI', sans-serif;
        color: white;
    }

    /* === Cyber Particle Background === */
    #cyber-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        background: radial-gradient(circle at center, #0a0f1f 0%, #04070f 100%);
        overflow: hidden;
    }

    .particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: rgba(0, 255, 170, 0.7);
        border-radius: 50%;
        opacity: 0.6;
        animation: floatUp linear infinite;
    }

    @keyframes floatUp {
        from { transform: translateY(100vh); opacity: 0; }
        to { transform: translateY(-20vh); opacity: 1; }
    }

    /* === Main Layout === */
    .dashboard-wrapper {
        display: flex;
        min-height: 100vh;
    }

    /* === Sidebar Styles === */
    .sidebar {
        background: rgba(10, 15, 31, 0.8);
        border-right: 1px solid rgba(0, 255, 170, 0.2);
        padding: 20px;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
        backdrop-filter: blur(10px);
        z-index: 100;
        width: 250px;
        flex-shrink: 0;
    }

    .sidebar h4 {
        color: #00ffaa;
        margin-bottom: 20px;
        font-size: 1.5rem;
        text-shadow: 0 0 6px rgba(0, 255, 170, 0.5);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Glass buttons */
    .btn-glass {
        padding: 14px 30px;
        font-size: 1.2rem;
        margin: 10px 0;
        border-radius: 10px;
        text-decoration: none;
        font-weight: bold;
        color: white;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        transition: 0.3s ease;
        display: block;
        width: 100%;
        text-align: center;
        margin-bottom: 20px;
    }

    .btn-glass:hover {
        background: rgba(0, 255, 170, 0.15);
        border-color: #00ffaa;
        transform: scale(1.02);
        box-shadow: 0 5px 15px rgba(0, 255, 170, 0.2);
    }

    .sidebar hr {
        border-color: rgba(0, 255, 170, 0.2);
        margin: 20px 0;
    }

    .sidebar h6 {
        color: #00ffaa;
        margin-bottom: 15px;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.9;
    }

    .list-group-item {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #d6eaff;
        margin-bottom: 8px;
        border-radius: 10px;
        transition: all 0.3s;
        padding: 15px;
    }

    .list-group-item:hover {
        background: rgba(0, 255, 170, 0.1);
        border-color: #00ffaa;
        transform: translateX(5px);
        box-shadow: 0 5px 15px rgba(0, 255, 170, 0.1);
    }

    .list-group-item.active {
        background: rgba(0, 255, 170, 0.2);
        border-color: #00ffaa;
    }

    .badge {
        background: #00ffaa;
        color: #000;
        font-weight: bold;
        border-radius: 10px;
        padding: 4px 8px;
        font-size: 0.8rem;
    }

    /* === Main Content Area === */
    .main-content {
        flex: 1;
        padding: 20px;
        min-height: 100vh;
        backdrop-filter: blur(5px);
        display: flex;
        flex-direction: column;
        align-items: center; /* This centers children horizontally */
        width: 100%;
    }

    /* Container that centers all content */
    .centered-container {
        width: 100%;
        max-width: 1200px;
        display: flex;
        flex-direction: column;
        align-items: center; /* Center children horizontally */
    }

    /* Dashboard Header */
    .dashboard-header {
        text-align: center;
        margin-bottom: 40px;
        width: 100%;
    }

    .dashboard-header h1 {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 15px;
        background: linear-gradient(90deg, #00ffaa, #00e0ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: glow 3s infinite alternate;
    }

    @keyframes glow {
        0% { text-shadow: 0 0 15px rgba(0, 255, 170, 0.3); }
        100% { text-shadow: 0 0 35px rgba(0, 255, 170, 0.8); }
    }

    /* Search Box */
    .search-box {
        position: relative;
        margin-bottom: 30px;
        width: 100%;
        max-width: 800px;
    }

    .search-box input[type="search"] {
        padding: 15px 50px 15px 20px;
        border-radius: 12px;
        border: 1px solid rgba(0, 255, 170, 0.3);
        background: rgba(255, 255, 255, 0.05);
        color: white;
        width: 100%;
        font-size: 1rem;
        transition: all 0.3s;
    }

    .search-box input[type="search"]:focus {
        outline: none;
        border-color: #00ffaa;
        box-shadow: 0 0 15px rgba(0, 255, 170, 0.3);
    }

    .search-box i {
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        color: #00ffaa;
        font-size: 1.2rem;
    }

    /* Tables */
    table {
        width: 100%;
        border-collapse: collapse;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 30px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    th, td {
        padding: 15px 20px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        vertical-align: middle;
        text-align: left;
    }

    th {
        background: rgba(0, 255, 170, 0.1);
        color: #00ffaa;
        font-weight: 600;
    }

    tr:hover {
        background: rgba(0, 255, 170, 0.05);
    }

    /* Buttons */
    .btn {
        padding: 8px 16px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        color: #000;
        font-weight: bold;
        display: inline-block;
        text-align: center;
        transition: all 0.3s;
    }

    .view-btn {
        background: linear-gradient(90deg, #00ffaa, #00ccff);
        transition: transform 0.2s, opacity 0.2s;
    }

    .view-btn:hover {
        opacity: 0.9;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 255, 170, 0.3);
    }

    .star-btn {
        background: transparent;
        color: gold;
        font-size: 22px;
        border: none;
        cursor: pointer;
        transition: transform 0.2s;
        padding: 5px;
    }

    .star-btn:hover {
        transform: scale(1.3);
    }

    /* Section Headers */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid rgba(0, 255, 170, 0.3);
        width: 100%;
        max-width: 1200px;
    }

    .section-header h2 {
        color: #00ffaa;
        font-size: 1.8rem;
        margin: 0;
        text-shadow: 0 0 6px rgba(0, 255, 170, 0.3);
    }

    .logout-btn {
        background: rgba(255, 107, 107, 0.1);
        border: 1px solid rgba(255, 107, 107, 0.3);
        color: #ff6b6b;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        transition: all 0.3s;
    }

    .logout-btn:hover {
        background: rgba(255, 107, 107, 0.2);
        border-color: #ff6b6b;
        transform: translateY(-2px);
    }

    /* Floating Card for empty states */
    .floating-card {
        margin-top: 20px;
        padding: 30px;
        border-radius: 15px;
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(12px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
        color: #cce7ff;
        line-height: 1.8;
        animation: float 4s ease-in-out infinite alternate;
        width: 100%;
        max-width: 800px;
        text-align: center;
    }

    @keyframes float {
        from { transform: translateY(0px); }
        to { transform: translateY(-10px); }
    }

    /* Content Wrappers - Centered */
    .content-section {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center; /* Center children horizontally */
        margin-bottom: 40px;
    }

    /* Table wrapper - ensures tables are centered but take full width */
    .table-wrapper {
        width: 100%;
        max-width: 1200px;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .dashboard-wrapper {
            flex-direction: column;
        }
        
        .sidebar {
            position: relative;
            height: auto;
            min-height: auto;
            border-right: none;
            border-bottom: 1px solid rgba(0, 255, 170, 0.2);
            width: 100%;
        }
        
        .main-content {
            padding: 15px;
        }
        
        .dashboard-header h1 {
            font-size: 2rem;
        }
        
        .section-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
        
        th, td {
            padding: 10px 12px;
        }
    }

    /* Scrollbar Styling */
    .sidebar::-webkit-scrollbar {
        width: 6px;
    }

    .sidebar::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
    }

    .sidebar::-webkit-scrollbar-thumb {
        background: rgba(0, 255, 170, 0.5);
        border-radius: 3px;
    }
</style>

<!-- Cyber Particle Background -->
<div id="cyber-bg"></div>

<div class="dashboard-wrapper">
    <!-- Code Scanner Sidebar -->
    <div class="sidebar">
        <h4><i class="bi bi-shield-check"></i> Code Scanner</h4>
        
        <form method="post" action="{{ path('code_scan_new_chat') }}" class="mb-3">
            <input type="hidden" name="_token" value="{{ csrf_token('new_chat') }}">
            <button type="submit" class="btn-glass">
                <i class="bi bi-plus-circle"></i> New Scan
            </button>
        </form>

        <hr>

        <h6>Recent Scans</h6>
        <div class="list-group">
            {% if chats is defined %}
                {% for chat in chats %}
                    <a href="{{ path('code_scan_chat', {id: chat.id}) }}" 
                       class="list-group-item list-group-item-action">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="text-truncate" style="flex: 1;">
                                <strong>{{ chat.title }}</strong>
                                <br>
                                <small>{{ chat.updatedAt|date('M d, H:i') }}</small>
                            </div>
                            <span class="badge">
                                {% if chat.messages is defined %}
                                    {{ chat.messages|length }}
                                {% else %}
                                    0
                                {% endif %}
                            </span>
                        </div>
                    </a>
                {% else %}
                    <div class="floating-card text-center" style="margin-top: 10px; padding: 15px;">
                        <i class="bi bi-code-slash" style="font-size: 1.5rem; color: #00ffaa; margin-bottom: 10px;"></i>
                        <p class="small">No scans yet. Create your first one!</p>
                    </div>
                {% endfor %}
            {% else %}
                <div class="floating-card text-center" style="margin-top: 10px; padding: 15px;">
                    <i class="bi bi-code-slash" style="font-size: 1.5rem; color: #00ffaa; margin-bottom: 10px;"></i>
                    <p class="small">No scans yet. Create your first one!</p>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
        <div class="centered-container">
            <!-- Dashboard Header -->
            <div class="dashboard-header">
                <div style="text-align: right; margin-bottom: 20px;">
                    <a href="{{ path('app_logout') }}" class="logout-btn">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </a>
                </div>
                <h1>Cybersecurity Dashboard</h1>
                <p style="color: #d6eaff; font-size: 1.2rem; max-width: 800px; margin: 0 auto;">
                    Welcome back! Explore articles, scan your code, and enhance your security skills.
                </p>
            </div>

            <!-- Search Box -->
            <form method="get" class="search-box">
                <input type="search" name="search" placeholder="Search articles by title or description..." value="{{ search }}">
                <i class="bi bi-search"></i>
            </form>

            <!-- All Articles Section -->
            <div class="content-section">
                <div class="section-header">
                    <h2><i class="bi bi-file-earmark-text"></i> All Articles</h2>
                    <span style="color: #00ffaa; font-size: 0.9rem;">{{ articles|length }} article(s)</span>
                </div>

                {% if articles|length > 0 %}
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Description</th>
                                    <th>View</th>
                                    <th>Favorite</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for article in articles %}
                                    <tr>
                                        <td>{{ article.title }}</td>
                                        <td>{{ article.description|slice(0,50) ~ '...' }}</td>
                                        <td>
                                            {% if article.filePath %}
                                                <a class="btn view-btn" href="{{ asset('uploads/' ~ article.filePath) }}" target="_blank">
                                                    <i class="bi bi-file-earmark-pdf"></i> View PDF
                                                </a>
                                            {% else %}
                                                <span style="color: #999; font-size: 0.9rem;">No file</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if article.id in favoriteIds %}
                                                <a href="{{ path('dashboard_remove_favorite', {id: article.id}) }}" class="star-btn">★</a>
                                            {% else %}
                                                <a href="{{ path('dashboard_add_favorite', {id: article.id}) }}" class="star-btn">☆</a>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="floating-card text-center">
                        <i class="bi bi-journal-x" style="font-size: 3rem; color: #00ffaa; margin-bottom: 15px;"></i>
                        <h3>No Articles Found</h3>
                        <p>Try a different search term or check back later for new content.</p>
                    </div>
                {% endif %}
            </div>

            <!-- Favorites Section -->
            <div class="content-section">
                <div class="section-header">
                    <h2><i class="bi bi-star-fill"></i> Your Favorites</h2>
                    <span style="color: gold; font-size: 0.9rem;">{{ favorites|length }} favorite(s)</span>
                </div>

                {% if favorites|length > 0 %}
                    <div class="table-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Description</th>
                                    <th>View</th>
                                    <th>Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for fav in favorites %}
                                    <tr>
                                        <td>{{ fav.article.title }}</td>
                                        <td>{{ fav.article.description|slice(0,50) ~ '...' }}</td>
                                        <td>
                                            {% if fav.article.filePath %}
                                                <a class="btn view-btn" href="{{ asset('uploads/' ~ fav.article.filePath) }}" target="_blank">
                                                    <i class="bi bi-file-earmark-pdf"></i> View PDF
                                                </a>
                                            {% else %}
                                                <span style="color: #999; font-size: 0.9rem;">No file</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <a href="{{ path('dashboard_remove_favorite', {id: fav.article.id}) }}" class="star-btn" style="color: #ff6b6b;">★</a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="floating-card text-center">
                        <i class="bi bi-star" style="font-size: 3rem; color: gold; margin-bottom: 15px;"></i>
                        <h3>No Favorites Yet</h3>
                        <p>Click the star icon ☆ next to articles to add them to your favorites.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script>
    // Generate animated particles
    const bg = document.getElementById('cyber-bg');
    for (let i = 0; i < 120; i++) {
        let p = document.createElement('div');
        p.className = 'particle';
        p.style.left = Math.random() * 100 + 'vw';
        p.style.animationDuration = 4 + Math.random() * 6 + 's';
        p.style.animationDelay = Math.random() * -10 + 's';
        bg.appendChild(p);
    }

    // Make sure the current chat is highlighted in sidebar
    document.addEventListener('DOMContentLoaded', function() {
        const currentPath = window.location.pathname;
        const chatLinks = document.querySelectorAll('.list-group-item');
        
        chatLinks.forEach(link => {
            if (link.getAttribute('href') === currentPath) {
                link.classList.add('active');
            }
        });
    });
</script>
{% endblock %}