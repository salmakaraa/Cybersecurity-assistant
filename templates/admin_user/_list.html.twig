<div class="users-header">
    <h1>Users Management</h1>
    <button class="btn-create new-user-btn" onclick="window.openCreateAdminModal()">➕ Add New Admin</button>
</div>

<h2>Admins</h2>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Email</th>
            <th>Roles</th>
            <th>Verified</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for user in users %}
            {% if 'ROLE_ADMIN' in user.roles %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.roles|join(', ') }}</td>
                <td>{{ user.isVerified ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('admin_user_delete', {id: user.id}) }}"
                       onclick="return confirm('Are you sure you want to delete this admin?')"
                       class="btn-action btn-delete">🗑️ Delete</a>
                </td>
            </tr>
            {% endif %}
        {% else %}
            <tr>
                <td colspan="5">No admins found.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

<h2>Users</h2>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Email</th>
            <th>Roles</th>
            <th>Verified</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% set hasUsers = false %}
        {% for user in users %}
            {% if 'ROLE_ADMIN' not in user.roles %}
                {% set hasUsers = true %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.roles|join(', ') }}</td>
                <td>{{ user.isVerified ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('admin_user_delete', {id: user.id}) }}"
                       onclick="return confirm('Are you sure you want to delete this user?')"
                       class="btn-action btn-delete">🗑️ Delete</a>
                </td>
            </tr>
            {% endif %}
        {% endfor %}
        {% if not hasUsers %}
            <tr>
                <td colspan="5">No users found.</td>
            </tr>
        {% endif %}
    </tbody>
</table>

<script>
// Create modal dynamically
(function() {
    const existingModal = document.getElementById('createAdminModal');
    if (existingModal) {
        existingModal.remove();
    }
    
    const modalHTML = `
        <div id="createAdminModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.8); z-index: 999999; justify-content: center; align-items: center;">
            <div style="background: #1a1f2e; color: #fff; width: 90%; max-width: 600px; padding: 30px; border-radius: 15px; box-shadow: 0 0 40px rgba(0, 0, 0, 0.7); position: relative; z-index: 1000000; max-height: 80vh; overflow-y: auto;">
                <h2 style="margin-bottom: 20px; font-size: 26px; color: #57a6ff; text-align: center;">Create New Admin</h2>
                <div id="modalFormContainer">
                    <p>Loading form...</p>
                </div>
                <div style="margin-top: 25px; display: flex; justify-content: flex-end; gap: 10px;">
                    <button type="button" onclick="window.closeCreateAdminModal()" style="background: #ff4d4d; color: #fff; padding: 12px 24px; border: none; border-radius: 10px; cursor: pointer; font-weight: 600;">Cancel</button>
                </div>
            </div>
        </div>
    `;
    document.body.insertAdjacentHTML('beforeend', modalHTML);
})();

window.openCreateAdminModal = async function() {
    const modal = document.getElementById('createAdminModal');
    if (!modal) return;
    
    modal.style.cssText = 'display: flex !important; position: fixed !important; top: 0 !important; left: 0 !important; width: 100vw !important; height: 100vh !important; background: rgba(0, 0, 0, 0.9) !important; z-index: 999999 !important; justify-content: center !important; align-items: center !important;';
    
    try {
        const response = await fetch('/create-admin');
        const html = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const form = doc.querySelector('form');
        
        if (form) {
            const container = document.getElementById('modalFormContainer');
            container.innerHTML = '';
            container.appendChild(form);
            
            form.onsubmit = async function(e) {
                e.preventDefault();
                
                // EASY VALIDATION - CHECK PASSWORD LENGTH
                const passwordInput = form.querySelector('input[type="password"]');
                const confirmPasswordInput = form.querySelectorAll('input[type="password"]')[1];
                
                if (passwordInput && passwordInput.value.length < 6) {
                    alert('Password must be at least 6 characters long!');
                    return;
                }
                
                if (passwordInput && confirmPasswordInput && passwordInput.value !== confirmPasswordInput.value) {
                    alert('Passwords do not match!');
                    return;
                }
                
                console.log('Form submitted - validation passed');
                
                const formData = new FormData(form);
                const btn = form.querySelector('button[type="submit"]');
                const originalText = btn ? btn.textContent : '';
                
                if (btn) {
                    btn.disabled = true;
                    btn.textContent = 'Creating...';
                }
                
                try {
                    const res = await fetch('/create-admin', {
                        method: 'POST',
                        body: formData,
                        headers: {'X-Requested-With': 'XMLHttpRequest'}
                    });
                    
                    const ct = res.headers.get('content-type');
                    
                    if (ct && ct.includes('json')) {
                        const json = await res.json();
                        if (json.success) {
                            window.closeCreateAdminModal();
                            location.reload();
                            return;
                        }
                    }
                    
                    // If not JSON, check for HTML errors
                    const resultHtml = await res.text();
                    const resultDoc = parser.parseFromString(resultHtml, 'text/html');
                    
                    // Check for form errors
                    const newForm = resultDoc.querySelector('form');
                    const errors = resultDoc.querySelectorAll('.invalid-feedback, .form-error, ul li');
                    
                    if (errors.length > 0) {
                        // Show form with errors
                        container.innerHTML = '';
                        container.appendChild(newForm);
                        
                        // Re-attach handler
                        newForm.onsubmit = arguments.callee;
                    } else {
                        // No errors found, reload
                        window.closeCreateAdminModal();
                        location.reload();
                    }
                } catch (err) {
                    console.error('Error:', err);
                    alert('Error creating user');
                    if (btn) {
                        btn.disabled = false;
                        btn.textContent = originalText;
                    }
                }
            };
        }
    } catch (err) {
        console.error('Error loading form:', err);
        document.getElementById('modalFormContainer').innerHTML = 
            '<p style="color: #ff4d4d;">Error loading form</p>';
    }
};

window.closeCreateAdminModal = function() {
    const modal = document.getElementById('createAdminModal');
    if (modal) modal.style.display = 'none';
};

// Add real-time password validation
document.addEventListener('input', function(e) {
    if (e.target.type === 'password') {
        const form = e.target.closest('form');
        if (!form) return;
        
        const passwordInputs = form.querySelectorAll('input[type="password"]');
        if (passwordInputs.length < 2) return;
        
        const password = passwordInputs[0];
        const confirmPassword = passwordInputs[1];
        
        // Show/hide password length error
        if (password.value && password.value.length < 6) {
            showPasswordError(password, 'Password must be at least 6 characters');
        } else {
            clearPasswordError(password);
        }
        
        // Show/hide password match error
        if (password.value && confirmPassword.value && password.value !== confirmPassword.value) {
            showPasswordError(confirmPassword, 'Passwords do not match');
        } else {
            clearPasswordError(confirmPassword);
        }
    }
});

function showPasswordError(input, message) {
    // Remove existing error
    clearPasswordError(input);
    
    // Add error style
    input.style.borderColor = '#ff4d4d';
    input.style.backgroundColor = 'rgba(255, 77, 77, 0.1)';
    
    // Create error message
    const error = document.createElement('div');
    error.textContent = message;
    error.style.color = '#ff4d4d';
    error.style.fontSize = '0.9rem';
    error.style.marginTop = '5px';
    error.className = 'password-error';
    
    input.parentNode.insertBefore(error, input.nextSibling);
}

function clearPasswordError(input) {
    input.style.borderColor = '';
    input.style.backgroundColor = '';
    
    const existingError = input.parentNode.querySelector('.password-error');
    if (existingError) {
        existingError.remove();
    }
}
</script>