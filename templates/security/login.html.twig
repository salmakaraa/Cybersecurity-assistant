{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}

    <link rel="stylesheet" href="{{ asset('css/admin.css') }}"> 
<div class="login-wrapper">

    <h1 class="login-title">Sign In Securely</h1>

   <!-- {% if error %}
        <div class="alert-danger">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    {% if app.user %}
        <div class="logged-msg">
            You are logged in as {{ app.user.userIdentifier }},
            <a href="{{ path('app_logout') }}" style="color:#00ffaa; text-decoration:underline;">Logout</a>
        </div>
    {% endif %}
-->
    <form method="post">

        <label for="inputEmail">Email</label>
        <input type="email"
               value="{{ last_username }}"
               name="email"
               id="inputEmail"
               autocomplete="email"
               required autofocus
        >

        <label for="inputPassword">Password</label>
        <input type="password"
               name="password"
               id="inputPassword"
               autocomplete="current-password"
               required
        >

        <input type="hidden"
               name="_csrf_token"
               value="{{ csrf_token('authenticate') }}"
        >

        <div class="remember-row">
            <input type="checkbox" name="_remember_me" id="rememberCheck">
            <label for="rememberCheck">Remember me</label>
        </div>

        <button class="submit-btn" type="submit">
            Sign in
        </button>
    </form>
</div>

{% endblock %}